# Переменные окружения (раздел 17 спецификации).
# Скопируйте в .env и подставьте значения. Приложение не стартует без
# APP_PROFILE и обязательных строк подключения.

# --- Профиль: dev | demo | prod -----------------------------------------
APP_PROFILE=dev
BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
LOG_JSON=true

# --- Хранилища -----------------------------------------------------------
# Роль crm_app: только SELECT/INSERT на audit_log, без UPDATE/DELETE
# (new_spec §3.3) — не суперпользователь crm/POSTGRES_PASSWORD ниже.
DATABASE_URL=postgresql+asyncpg://crm_app:crm_app@localhost:5432/crm
# Только для `alembic upgrade head` вне docker compose: миграциям нужен DDL
# (CREATE ROLE/TABLE/FUNCTION, GRANT), которого у crm_app сознательно нет.
# Внутри docker compose это учтено отдельным DATABASE_URL сервиса `migrate`
# (см. docker-compose.yml) — эта переменная нужна только при запуске
# alembic локально напрямую, тем же приёмом, что и KEYCLOAK_INTERNAL_URL.
# Читается ТОЛЬКО из окружения процесса (`export`/`$env:`), не из этого файла: `migrations/env.py`
# смотрит в `os.environ`. В CI файл копируется как есть, и подхват отсюда сбил бы адрес базы.
MIGRATIONS_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
KC_DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/keycloak
REDIS_URL=redis://localhost:6379/0

# --- Keycloak ------------------------------------------------------------
# Публичный адрес: из него формируется issuer токенов и ссылка входа.
KEYCLOAK_URL=http://localhost:8080/auth
# Адрес для серверных вызовов внутри контура. В docker-compose задаётся
# автоматически как http://keycloak:8080/auth; при локальном запуске оставьте пустым.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=crm
KEYCLOAK_CLIENT_ID=crm-bff
KEYCLOAK_CLIENT_SECRET=crm-bff-secret
KEYCLOAK_ADMIN_CLIENT_ID=crm-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=crm-admin-secret
KEYCLOAK_JWKS_TTL=3600
# Включать, когда у клиента настроен audience-mapper (в поставляемом realm он есть).
KEYCLOAK_VERIFY_AUDIENCE=true

# --- SeaweedFS (S3-совместимое хранилище; MinIO запрещён) ----------------
S3_ENDPOINT_URL=http://localhost:8333
# Адрес presigned-ссылок, которые разыменовывает браузер клиента, а не
# сервер (раздел 9). Оставлен закомментированным: docker-compose читает
# этот же .env для своей подстановки ${...}, а его собственный дефолт
# (http://localhost:8333, порт Caddy из Caddyfile) и так совпадает с
# S3_ENDPOINT_URL выше — раскомментировать только если адреса должны разойтись.
# S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=crm_access
S3_SECRET_KEY=crm_secret_key
S3_REGION=us-east-1
S3_BUCKET_FILES=files
S3_BUCKET_IMPORTS=imports
S3_BUCKET_REPORTS=reports
S3_BUCKET_SIGNATURES=signatures
S3_BUCKET_REGISTRY=registry

# --- Сессии и токены -----------------------------------------------------
SESSION_TTL=43200
# Простой дольше этого времени завершает сессию (new_spec §3.1: 30 минут).
SESSION_IDLE_TIMEOUT=1800
ACCESS_TOKEN_TTL=300
# Рабочий день: серверная сессия обновляет access-токен по refresh,
# поэтому refresh обязан жить дольше, чем access.
REFRESH_TOKEN_TTL=28800
ACCESS_TOKEN_REFRESH_LEEWAY=30
# Double-submit CSRF для мутирующих запросов из браузера.
CSRF_ENABLED=true
CSRF_COOKIE_NAME=crm_csrf
CSRF_HEADER_NAME=X-CSRF-Token
# Прямой вход по Authorization: Bearer в обход серверной сессии. В prod
# автоматически ограничивается ролью INTEGRATION.
ALLOW_BEARER_AUTH=true

# --- Файлы ---------------------------------------------------------------
FILES_MAX_SIZE_BYTES=52428800
DEAL_FILES_MAX_SIZE_BYTES=524288000
# SVG запрещён спецификацией. json — выгрузка «Данные оплат» для импорта оплат.
ALLOWED_FILE_EXTENSIONS=png,jpeg,jpg,pdf,zip,gz,gzip,rar,doc,docx,xls,xlsx,xml,csv,json

# --- Отчёты --------------------------------------------------------------
REPORTS_MAX_CONCURRENT=10
REPORTS_LINK_TTL_MINUTES=15
REPORTS_RETENTION_DAYS=7

# --- Импорт --------------------------------------------------------------
IMPORT_MAX_ROWS=100000
IMPORT_MAX_FILE_SIZE_BYTES=52428800
IMPORT_BATCH_SIZE=500

# --- Автоподстановка по ИНН ---------------------------------------------
ORG_LOOKUP_RATE_LIMIT_PER_MIN=30
EXTERNAL_ORG_LOOKUP_ENABLED=false

# --- ПЭП -----------------------------------------------------------------
PUBLIC_SIGN_RATE_LIMIT_PER_MIN=10
SIGNATURE_TOKEN_TTL_DAYS=7
SIGNATURE_OTP_TTL_SECONDS=300
SIGNATURE_OTP_MAX_ATTEMPTS=3
# Обязательно заменить в prod: используется для HMAC-метки целостности подписи.
SIGNATURE_SERVER_SECRET=change-me-in-prod
# Необязательно: Fernet-ключ, которым шифруются значения секретных системных настроек в БД
# (`python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
# Без него секреты лежат открытым текстом и в лог пишется предупреждение. Читается из окружения
# процесса, поэтому в docker compose его нужно добавить в список `x-api-env`.
# SETTINGS_ENCRYPTION_KEY=
SIGNATURE_KEY_VERSION=1
# Доверенное время (dop.md §10.8/§13) — контейнеры `ntp`/`sms-gateway-mock`
# всегда часть стека (см. docker-compose.yml), поэтому дефолты — сетевые
# имена docker compose, а не пусто-означает-выключено, как у LMS/Bitrix ниже.
NTP_HOST=ntp
NTP_PORT=123
NTP_TIMEOUT_SECONDS=2.0
SIGNATURE_MAX_CLOCK_DRIFT_MS=5000
SMS_GATEWAY_URL=http://sms-gateway-mock:8090

# --- Интеграции ----------------------------------------------------------
# *_REF — имя переменной окружения, где реально лежит секрет (раздел 7.8:
# «ссылка на секрет, НЕ сам секрет»), не значение. Обе переменные ниже
# объявлены отдельно (и передаются в контейнеры через `x-api-env` в
# docker-compose.yml) именно под этими именами — при желании использовать
# другие имена нужно поменять их в обоих местах.
CMS_WEBHOOK_SECRET_REF=CMS_WEBHOOK_SECRET
CMS_WEBHOOK_SECRET=
LMS_BASE_URL=
LMS_AUTH_REF=
BITRIX_CONNECTOR_ENABLED=false
BITRIX_WEBHOOK_URL_REF=BITRIX_WEBHOOK_URL
# Секрет — это весь URL входящего вебхука целиком
# (https://{портал}/rest/{user_id}/{webhook_code}), см. `integration/bitrix.py`.
BITRIX_WEBHOOK_URL=
# Код источника сделки (`sourceId` в crm.item.add) из справочника вашего портала.
BITRIX_SOURCE_ID=OTHER
INTEGRATION_WEBHOOK_RATE_LIMIT_PER_MIN=60

# --- LLM -----------------------------------------------------------------
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30

# --- Администрирование пользователей -------------------------------------
# Приглашение: одноразовая ссылка, в базе только sha256 токена.
INVITE_TTL_HOURS=72
INVITE_RESEND_INTERVAL_SECONDS=300
INVITE_RESEND_PER_DAY=5
# Форма смены пароля: 5 неудач подряд блокируют её на 15 минут.
PASSWORD_CHANGE_MAX_ATTEMPTS=5
PASSWORD_CHANGE_LOCK_SECONDS=900
# 152-ФЗ: grace period перед обезличиванием и срок исполнения запроса субъекта.
ERASURE_GRACE_DAYS=30
ERASURE_SUBJECT_DEADLINE_DAYS=30
# Срок жизни заявки на подтверждение вторым администратором.
ADMIN_APPROVAL_TTL_SECONDS=86400

# --- Прочее --------------------------------------------------------------
# Действующая редакция политики публикуется через system_settings `pdn_policy`
# и перекрывает эти значения.
CONSENT_POLICY_VERSION=1.0
CONSENT_POLICY_TEXT_HASH=
DOCS_ENABLED=true
# Схема OpenAPI публикуется всегда, даже когда Swagger UI закрыт.
OPENAPI_ENABLED=true

# --- Только для docker compose ------------------------------------------
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
# Пароль ограниченной роли crm_app, под которой реально подключаются
# api/worker (см. DATABASE_URL выше) — обязательно сменить в проде, как и
# SIGNATURE_SERVER_SECRET/POSTGRES_PASSWORD.
CRM_APP_PASSWORD=crm_app
POSTGRES_DB=crm
# Порт Postgres на хосте для pgAdmin. Не 5432: он часто занят локальным Postgres.
POSTGRES_PORT=5433
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PUBLIC_URL=http://localhost:8080/auth
HTTP_PORT=8080
HTTPS_PORT=8443
# Проброс на хост порта S3-прокси Caddy (presigned-ссылки, см. Caddyfile).
S3_PROXY_PORT=8333
# Имя TLS-сайта в Caddyfile (SNI сертификата `tls internal`). Смените, если
# стенд открывается не по localhost — иначе сертификат не совпадёт с именем.
CRM_TLS_HOST=localhost
# Куда Caddy отдаёт всё, что не /api, /public, /health, /static и не /auth.
# Дефолт — образ web (профиль web); при разработке переопределяется на
# host.docker.internal:5273, чтобы Caddy проксировал на Vite на хосте.
WEB_UPSTREAM=web:3000
# script-src в CSP страниц. Дефолт для собранного клиента; при разработке
# ослабляется до "'self' 'unsafe-inline' 'unsafe-eval'" — нужно Vite HMR.
CSP_SCRIPT_SRC="'self'"
# Режим образа web: demo — экран входа предлагает выбрать демо-учётку;
# prod — только вход через Keycloak, без демо-учёток в /config.json.
APP_MODE=demo
# Один воркер на контейнер: реестр метрик Prometheus живёт в памяти процесса,
# и при нескольких воркерах scrape видел бы лишь часть трафика.
# Масштабирование — репликами: docker compose up -d --scale api=3
UVICORN_WORKERS=1
