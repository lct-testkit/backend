# Shell-скрипты и Dockerfile должны попадать в образ с LF,
# иначе контейнер падает на `\r` в шебанге.
*.sh text eol=lf
entrypoint.sh text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
