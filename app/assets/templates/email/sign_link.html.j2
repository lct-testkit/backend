{% extends "layout.html.j2" %}{% from "_macros.j2" import button, facts %}
{% block title %}{{ subject }}{% endblock %}
{% block preheader %}{% if deadline %}«{{ title }}» ждёт вашей подписи до {{ deadline }}.{% else %}«{{ title }}» ждёт вашей подписи.{% endif %}{% endblock %}
{% block heading %}{% if reminder %}Документ ждёт вашей подписи{% else %}Вам направлен документ на подпись{% endif %}{% endblock %}
{% block content %}
<p style="margin:0 0 12px 0;">Здравствуйте!</p>
<p style="margin:0 0 12px 0;">{% if reminder %}Напоминаем: документ ещё не подписан. {% endif %}Вас просят подписать документ простой электронной подписью. Откройте его по кнопке ниже, проверьте содержимое и подтвердите подпись кодом из SMS или письма.</p>
{{ facts([("Документ", title), ("Срок подписания", ("до " ~ deadline) if deadline else none), ("Ссылка действует", ("до " ~ link_until) if link_until else none)]) }}
{% endblock %}
{% block button %}{{ button(url, "Открыть и подписать") }}{% endblock %}
{% block note %}Ссылка личная: не пересылайте её другим людям. Если вы не ожидали это письмо, проигнорируйте его: без вашего подтверждения подпись не ставится.{% endblock %}
