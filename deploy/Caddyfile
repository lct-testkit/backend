# Единая точка входа контура.
#
# Caddy отвечает за TLS-терминацию и генерирует X-Request-Id, если клиент его
# не передал. Дальше этот идентификатор проходит через логи, аудит и тело
# ошибок Problem Details.
#
# HTTP-сайт слушает без имени хоста (catch-all), поэтому TLS-сайт обязан
# иметь имя: два безымянных блока с разными политиками TLS конфликтуют.
# Имя берётся из CRM_TLS_HOST, по умолчанию localhost.
#
# Режимы TLS задают переменные окружения (их пишет scripts/gen_env.sh, по умолчанию —
# прежнее поведение локального стенда):
#   CRM_TLS_HOST     имя TLS-сайта (SNI/ACME)                           localhost
#   CRM_TLS_PORT     порт TLS-сайта внутри контейнера                   8443 (на публичном хосте — 443)
#   CRM_TLS_SNIPPET  tls_internal (самоподписанный) | tls_acme (Let's Encrypt)   tls_internal
#   S3_SITE_ADDRESS  адрес сайта S3-прокси (`:8333` или `хост:8333`)   :8333
#   S3_TLS_SNIPPET   TLS S3-сайта: tls_none | tls_internal | tls_acme     tls_none
# С публичным именем на 443 Caddy сам поднимает :80: выпускает сертификат (HTTP-01) и
# редиректит http на https. Сертификаты лежат в томе caddy_data — при `down -v` они теряются
# (у Let's Encrypt лимит выпусков на домен), не удаляйте том без нужды.

{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

# --- TLS-режимы (выбираются переменными CRM_TLS_SNIPPET / S3_TLS_SNIPPET) ---------------------
(tls_internal) {
	# Самоподписанный сертификат: в закрытом контуре внешний CA недоступен.
	tls internal
}

(tls_acme) {
	# Сертификат Let's Encrypt (нужны публичный DNS и порт 80 из интернета).
	tls {
		issuer acme
	}
}

(tls_none) {
	# Без TLS-директив: S3-прокси в локальном режиме отдаётся по plain http.
}

(common_headers) {
	# Content-Security-Policy задаётся в crm_routes (не для /auth/*), здесь — остальные заголовки.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}
}

(crm_routes) {
	import common_headers

	# Веб-клиент (SPA) отдаётся с того же origin. Скрипты только со своего origin (сборка выносит
	# bootstrap SvelteKit в /boot.js), presigned-ссылки SeaweedFS (загрузка, скачивание, PDF на
	# странице подписания) живут на порту S3-прокси — им разрешены connect/img/frame.
	# В локальной разработке с Vite (CSP_SCRIPT_SRC="'self' 'unsafe-inline' 'unsafe-eval'") политику
	# ослабляют только для скриптов.
	# Не для /auth/*: страницы входа и консоль Keycloak используют inline-скрипты (importmap), и наша
	# script-src 'self' их блокировала. Там действует собственная CSP Keycloak (frame-ancestors 'self',
	# object-src 'none'). `>` — отложенная установка: перекрывает CSP апстрима, как и раньше.
	@app_csp not path /auth/*
	header @app_csp >Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: {$S3_ORIGIN}; connect-src 'self' {$S3_ORIGIN}; style-src 'self' 'unsafe-inline'; script-src {$CSP_SCRIPT_SRC:'self'}; worker-src 'self' blob:; object-src 'self' blob:; frame-src 'self' blob: {$S3_ORIGIN}; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"

	# Прокидываем идентификатор запроса или создаём новый.
	@no_request_id not header X-Request-Id *
	request_header @no_request_id X-Request-Id {http.request.uuid}

	# Журнал доступа: токены подписания и приглашений живут в пути запроса, а с токеном из лога можно
	# открыть страницу подписи или принять приглашение — их закрываем. Заголовки Authorization и
	# Cookie Caddy в журнале скрывает сам.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri regexp ^(/(?:public/sign|api/auth/invite)/)[^/?\s]+ ${1}REDACTED
			}
		}
	}

	# Keycloak отдаётся под /auth, чтобы весь контур жил на одном порту.
	# Именно handle, а не handle_path: Keycloak сам слушает на /auth
	# (KC_HTTP_RELATIVE_PATH), поэтому префикс срезать нельзя.
	# Консоль администратора Keycloak и realm master — только из закрытой сети (localhost, docker,
	# VPN, ssh-туннель): с публичного адреса админ-вход не должен быть виден вовсе, а пароль
	# администратора по умолчанию известен. Расширить круг: ADMIN_CONSOLE_ALLOW="10.0.0.0/8 203.0.113.7".
	# `client_ip` учитывает trusted_proxies, поэтому за внешним прокси проверяется адрес клиента.
	@kc_admin_outside {
		path /auth/admin /auth/admin/* /auth/realms/master /auth/realms/master/*
		not client_ip {$ADMIN_CONSOLE_ALLOW:private_ranges}
	}
	handle @kc_admin_outside {
		respond "Not Found" 404
	}

	handle /auth/* {
		reverse_proxy keycloak:8080
	}

	# Метрики наружу не выставляются: их собирает Prometheus внутри сети.
	handle /metrics {
		respond "Not Found" 404
	}

	# API, публичные ручки подписания/проверки, health и статика Swagger UI (`/static/swagger/*`, `app/api/docs.py`,
	# смонтирована на самом FastAPI-приложении абсолютным путём, не под `/api`) — в FastAPI.
	@backend path /api/* /public/* /health/* /static/*
	handle @backend {
		reverse_proxy {
			# Динамическое разрешение DNS вместо статического апстрима:
			# `docker compose up --scale api=3` подхватывается без
			# перезапуска Caddy. У api один воркер на контейнер, поэтому
			# масштабирование идёт именно репликами.
			dynamic a {
				name api
				port 8000
				refresh 10s
			}
			lb_policy least_conn
			header_up X-Real-IP {remote_host}
			# Тяжёлые отчёты и импорты отвечают дольше дефолтных таймаутов.
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	# Шрифты Rostelecom Basis. Они лицензионные и в git и образ `web` не входят (frontend/static/fonts
	# в .gitignore, файлы выдаёт заказчик), поэтому лежат отдельным каталогом, смонтированным в /srv/fonts
	# (compose: FONTS_DIR, по умолчанию ./fonts). Порядок: файл из каталога -> иначе апстрим (в разработке
	# Vite отдаёт шрифты сам) -> если апстрим ответил HTML-заглушкой SPA, отдаём честный 404. Без этого
	# SPA-fallback отвечает на /fonts/*.woff файлом index.html с кодом 200, браузер пишет «downloadable font:
	# rejected by sanitizer», хотя нужна просто запасная гарнитура. no-cache: браузер не залипает на старом ответе.
	# Вложенный `route`: порядок директив внутри должен остаться как написан (file_server до reverse_proxy),
	# а сам `handle` нужен, чтобы блок входил в ту же взаимоисключающую группу, что и остальные handle.
	handle /fonts/* {
		route {
			header Cache-Control "no-cache"
			root * /srv
			file_server {
				pass_thru
			}
			reverse_proxy {$WEB_UPSTREAM:web:3000} {
				@spa_fallback header Content-Type text/html*
				handle_response @spa_fallback {
					respond "Not Found" 404
				}
			}
		}
	}

	# Всё остальное — веб-клиент (статический SPA-образ `web`; в разработке WEB_UPSTREAM указывает на Vite).
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}

:8080 {
	import crm_routes
}

{$CRM_TLS_HOST:localhost}:{$CRM_TLS_PORT:8443} {
	import {$CRM_TLS_SNIPPET:tls_internal}
	import crm_routes
}

# Presigned PUT/GET к SeaweedFS (раздел 9): API подписывает ссылки на этот
# порт (S3_PUBLIC_ENDPOINT_URL), браузер клиента ходит сюда напрямую, минуя
# API — иначе загрузка файла шла бы через воркер API, чего раздел 3.7 прямо
# запрещает. Отдельный порт, а не префикс пути на :8080/:8443: подпись
# SigV4 считается по полному пути запроса, и любой стрипинг префикса
# прокси меняет подписанный путь и роняет проверку подписи на SeaweedFS —
# префикс пути в принципе несовместим с presigned-URL так же, как был бы
# несовместим с Keycloak, если бы у него не было собственного KC_HTTP_RELATIVE_PATH.
{$S3_SITE_ADDRESS::8333} {
	import {$S3_TLS_SNIPPET:tls_none}
	reverse_proxy seaweedfs:8333
}
